# Everything the image must not carry: local state, collected data, secrets.
.git
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
*.egg-info

# Collected data and derived reports — regenerated, never shipped.
*.log
*.jsonl
backtest_report*.json
matches_*.json
reviews.json

# Secrets. These arrive as environment variables in the cloud, never in a layer.
.env
*.pem
*.key

tests
.claude
CLAUDE.md
