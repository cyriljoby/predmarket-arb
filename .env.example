# Copy this file to `.env` (gitignored) and fill in your credentials.
# Needed ONLY for the live WebSocket feeds — public REST endpoints need none.

# --- Kalshi --------------------------------------------------------------- #
# Create at: https://kalshi.com/account/profile  ->  API Keys  ->  Create New
# You get a Key ID and a downloaded RSA private key (.txt) shown ONCE.
KALSHI_API_KEY_ID=
#
# Give the private key EITHER as a path to the file or inline. Local runs want
# the path — the key stays a file outside the repo and this variable is just a
# pointer. Containers want the inline form: there is no such file in the image,
# and an env var is the only shape a secret store can hand a process.
# KALSHI_PRIVATE_KEY wins if both are set.
KALSHI_PRIVATE_KEY_PATH=~/.secrets/kalshi_private_key.txt
# Whole PEM on one line, newlines written as the two characters \n — that is
# how `docker run -e` and most secret stores deliver a multi-line value, and
# the loader converts them back:
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n

# --- Polymarket US -------------------------------------------------------- #
# Requires the Polymarket US app + identity verification (KYC) FIRST, then:
# https://polymarket.us/developer  ->  create key  ->  Key ID + Secret Key (shown ONCE)
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=
